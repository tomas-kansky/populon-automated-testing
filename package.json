{
  "name": "populon-automated-testing",
  "version": "1.0.0",
  "description": "Automated End-to-End (E2E) testing suite for Populon (demo.populon.app) built with Playwright and TypeScript using the Page Object Model (POM).",
  "main": "index.js",
  "scripts": {
    "demo": "playwright test --config=playwright.demo.config.ts",
    "demo:scenarios": "playwright test --config=playwright.demo.config.ts tests/scenarios.spec.ts",
    "demo:ui": "playwright test --config=playwright.demo.config.ts --ui",
    "demo:smoke": "playwright test --config=playwright.demo.config.ts --grep @smoke",
    "demo:auth": "playwright test --config=playwright.demo.config.ts tests/auth.spec.ts",
    "demo:search": "playwright test --config=playwright.demo.config.ts tests/search.spec.ts",
    "demo:dashboard": "playwright test --config=playwright.demo.config.ts tests/dashboard.spec.ts",
    "test": "playwright test",
    "test:scenarios": "playwright test tests/scenarios.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test tests/auth.spec.ts",
    "test:search": "playwright test tests/search.spec.ts",
    "test:dashboard": "playwright test tests/dashboard.spec.ts",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e-testing",
    "page-object-model",
    "qa-automation",
    "populon"
  ],
  "author": "Tomas Kansky",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
